# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gri_db
DB_USERNAME=root
DB_PASSWORD=

# Local Offline LLM Configuration (No external API keys required, 100% offline)
AI_ENGINE=local_offline
LOCAL_LLM_ENABLED=true
AI_API_KEY=
AI_MODEL=local-offline-gri-engine
GEMINI_ENABLED=false

# Mail SMTP Configuration
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@company.com
MAIL_FROM_NAME="Company AI Assistant"

# Application Settings
APP_ENV=development
APP_SECRET=super_secret_jwt_or_session_key_32bytes_min
